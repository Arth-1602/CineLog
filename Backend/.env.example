# CineLog Backend Environment Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# Local MongoDB connection string or MongoDB Atlas URI:
MONGODB_URI=mongodb://127.0.0.1:27017/cinelog

# Security & CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# External Provider: The Movie Database (Optional)
# Never commit real API keys to version control.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
